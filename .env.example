# ───────────────────────────────────────────────────────────────────────────
# NexoFlow — configuración local
# Copia este fichero a .env y sustituye CAMBIA_ESTA_CONTRASEÑA por la
# contraseña que elegiste para el usuario nexoflow_app.
# .env NO se sube a Git ni se incluye en el ZIP.
#
# Si la contraseña tiene caracteres especiales (@ : / ? # % & espacio…),
# escríbelos codificados para URL: @ → %40, : → %3A, / → %2F, # → %23, % → %25
# ───────────────────────────────────────────────────────────────────────────

# Base de datos principal.
DATABASE_URL="postgresql://nexoflow_app:CAMBIA_ESTA_CONTRASEÑA@localhost:5432/nexoflow"

# Base de datos SOLO para pruebas de integración y end-to-end (se borra su contenido).
TEST_DATABASE_URL="postgresql://nexoflow_app:CAMBIA_ESTA_CONTRASEÑA@localhost:5432/nexoflow_test"

# Dirección pública de la aplicación (enlaces en correos de recuperación).
APP_URL="http://localhost:3000"

# Número de proxies de confianza delante de la aplicación (para conocer la IP
# real al limitar intentos). En tu ordenador, sin proxy: 0.
TRUSTED_PROXY_HOPS="0"

# Cookies solo por HTTPS. Por defecto: true en producción y false en desarrollo.
# COOKIE_SECURE="true"

# Opcional: contraseña del usuario de demostración (npm run db:seed).
# Si no la defines, se genera una aleatoria y se muestra una vez.
# DEMO_USER_PASSWORD=""

# Opcional: solo para crear migraciones nuevas si nexoflow_app no tiene CREATEDB.
# SHADOW_DATABASE_URL=""
